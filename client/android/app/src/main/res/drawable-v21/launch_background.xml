<?xml version="1.0" encoding="utf-8"?>
<!-- The window the OS shows until Flutter draws its first frame: the ritual
     canvas with the emblem, so the entrance appears to have been there all
     along rather than arriving after a white flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_emblem" />
    </item>
</layer-list>
